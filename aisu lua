-- Main Physics, Expanded Camera View, Blizzard Toggle/Intensity, Auto Rock Bypass, Auto Forward & Sea-Boss Attack Loop
RunService.RenderStepped:Connect(function(dt)
    if not isConnected then return end

    if wideViewEnabled then
        pcall(function()
            if player.CameraMaxZoomDistance < maxZoomDist then
                player.CameraMaxZoomDistance = maxZoomDist
            end
        end)
        if camera and math.abs(camera.FieldOfView - cameraFov) > 0.5 then
            camera.FieldOfView = cameraFov
        end
    end
    
    if removeFogEnabled then
        updateFog()
        updateSnowEffect(dt or 0.016)
    end
    
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local myHrp = hrp
    
    if humanoid then
        if speedBuffEnabled then
            humanoid.WalkSpeed = playerSpeed
        end
        if jumpBuffEnabled then
            pcall(function()
                humanoid.JumpPower = playerJump
                humanoid.UseJumpPower = true
            end)
        end
    end
    
    if playerEspEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local char = p.Character
                local head = char:FindFirstChild("Head")
                local p_humanoid = char:FindFirstChildOfClass("Humanoid")
                local p_hrp = char:FindFirstChild("HumanoidRootPart")
                
                if head and p_humanoid then
                    local hp = math.floor(p_humanoid.Health)
                    local maxHp = math.floor(p_humanoid.MaxHealth)
                    local dist = (myHrp and p_hrp) and math.floor((p_hrp.Position - myHrp.Position).Magnitude) or 0
                    
                    local displayLv = "Lv.Max"
                    if p:FindFirstChild("Data") and p.Data:FindFirstChild("Level") then
                        displayLv = "Lv." .. tostring(p.Data.Level.Value)
                    end
                    
                    local teamName = p.Team and p.Team.Name:lower() or ""
                    local accentColor = Color3.fromRGB(255, 75, 75)
                    local teamLabel = "[海賊]"
                    
                    if teamName:find("marine") or teamName:find("海軍") then
                        accentColor = Color3.fromRGB(0, 210, 255)
                        teamLabel = "[海軍]"
                    end
                    
                    local infoText = string.format("%s %s\n(%s) HP: %d/%d  距離: %dm", teamLabel, p.Name, displayLv, hp, maxHp, dist)
                    updateOrCreateEsp(head, infoText, accentColor, "PlayerESP_UI")
                end
            end
        end
    end
    
    if bossEspEnabled then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if isTargetSeaBossModel(obj) then
                local targetPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("BasePart")
                local b_humanoid = obj:FindFirstChildOfClass("Humanoid")
                
                if targetPart then
                    local hpStr = b_humanoid and string.format("HP: %d/%d", math.floor(b_humanoid.Health), math.floor(b_humanoid.MaxHealth)) or "HP: Unknown"
                    local dist = myHrp and math.floor((targetPart.Position - myHrp.Position).Magnitude) or 0
                    local bossText = string.format("[SEA BOSS] %s\n%s  距離: %dm", obj.Name, hpStr, dist)
                    
                    updateOrCreateEsp(targetPart, bossText, Color3.fromRGB(255, 150, 0), "BossESP_UI")
                end
            end
        end
    end
    
    if not character then return end

    -- 水上歩行
    if walkOnWaterEnabled and humanoid and not humanoid.SeatPart then
        if myHrp then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)

            if not waterFloorPart or not waterFloorPart.Parent then
                waterFloorPart = Instance.new("Part")
                waterFloorPart.Name = "DynamicWaterFloor"
                waterFloorPart.Size = Vector3.new(16, 0.4, 16)
                waterFloorPart.Transparency = 1
                waterFloorPart.Anchored = true
                waterFloorPart.CanCollide = true
                waterFloorPart.Parent = Workspace
            end

            waterFloorPart.CFrame = CFrame.new(myHrp.Position.X, 1.0, myHrp.Position.Z)
        end
    else
        destroyWaterFloor()
    end

    -- VehicleSeat 速度上書き
    local activeVehicleSeat = nil
    if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
        activeVehicleSeat = humanoid.SeatPart
        if currentSeat ~= activeVehicleSeat then
            if currentSeat and originalMaxSpeed then
                currentSeat.MaxSpeed = originalMaxSpeed
            end
            currentSeat = activeVehicleSeat
            originalMaxSpeed = activeVehicleSeat.MaxSpeed
        end

        if not shipFreezeEnabled then
            activeVehicleSeat.MaxSpeed = boatSpeed
        end
    else
        if currentSeat and originalMaxSpeed then
            currentSeat.MaxSpeed = originalMaxSpeed
            currentSeat = nil
        end
    end

    -- ★ おーとりヴぁ：岩をすり抜けながら自動で前へ進み、検知した海レボスを攻撃する
    if autoLivaEnabled and myHrp and humanoid then
        local now = tick()
        local shipModel = activeVehicleSeat and activeVehicleSeat.Parent or nil
        if now - lastRockScanTime >= 0.35 then
            lastRockScanTime = now
            updateRockNoclip(myHrp.Position, shipModel)
        end

        local bossModel, bossPart, bossDist = findNearestSeaBoss(myHrp.Position)

        if bossPart then
            equipGunWeapon(character, humanoid)

            local flatGoal = Vector3.new(bossPart.Position.X, myHrp.Position.Y, bossPart.Position.Z)
            local toBoss = flatGoal - myHrp.Position
            local distFlat = toBoss.Magnitude

            if activeVehicleSeat then
                if distFlat > 25 then
                    driveBoatToward(activeVehicleSeat, toBoss, math.clamp(boatSpeed * 0.2, 35, 110))
                else
                    pcall(function()
                        activeVehicleSeat.Throttle = 0
                    end)
                end
            else
                if distFlat > 12 then
                    local dir = toBoss.Unit
                    myHrp.CFrame = CFrame.lookAt(myHrp.Position, Vector3.new(bossPart.Position.X, myHrp.Position.Y, bossPart.Position.Z))
                    local moveSpeed = math.max(playerSpeed, 55)
                    myHrp.AssemblyLinearVelocity = Vector3.new(dir.X * moveSpeed, myHrp.AssemblyLinearVelocity.Y, dir.Z * moveSpeed)
                else
                    myHrp.CFrame = CFrame.lookAt(myHrp.Position, Vector3.new(bossPart.Position.X, myHrp.Position.Y, bossPart.Position.Z))
                end
            end

            if bossDist <= 250 then
                attackSeaBoss(bossPart)
            end
        else
            -- ボスがいない間は自動で前へ進む
            if activeVehicleSeat then
                driveBoatToward(activeVehicleSeat, nil, math.clamp(boatSpeed * 0.2, 35, 110))
            else
                local forward = myHrp.CFrame.LookVector
                local flatForward = Vector3.new(forward.X, 0, forward.Z)
                if flatForward.Magnitude > 0.01 then
                    flatForward = flatForward.Unit
                    local cruiseSpeed = math.max(playerSpeed, 50)
                    myHrp.AssemblyLinearVelocity = Vector3.new(flatForward.X * cruiseSpeed, myHrp.AssemblyLinearVelocity.Y, flatForward.Z * cruiseSpeed)
                end
            end
        end
    end
end)
