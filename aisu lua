-- Helper: Slider
local function createSlider(yPos, minVal, maxVal, defaultVal, isFloat, parentFrame, onValueChanged)
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(0.88, 0, 0, 34)
    sliderFrame.Position = UDim2.new(0.06, 0, 0, yPos)
    sliderFrame.BackgroundTransparency = 1
    sliderFrame.Visible = false
    sliderFrame.ZIndex = 10
    sliderFrame.Parent = parentFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 14)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 11
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.ZIndex = 10
    label.Parent = sliderFrame

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 19)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    track.BorderSizePixel = 0
    track.ZIndex = 10
    track.Parent = sliderFrame

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local knob = Instance.new("ImageButton")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.fromRGB(120, 120, 240)
    knob.BorderSizePixel = 0
    knob.ZIndex = 11
    knob.Parent = track

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local dragging = false

    local function updateValue(input)
        local posX = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        knob.Position = UDim2.new(posX, 0, 0.5, 0)
        local rawVal = minVal + (maxVal - minVal) * posX
        local finalVal = isFloat and (math.floor(rawVal * 10) / 10) or math.floor(rawVal)
        onValueChanged(finalVal, label)
    end

    local initRatio = (defaultVal - minVal) / (maxVal - minVal)
    knob.Position = UDim2.new(initRatio, 0, 0.5, 0)
    onValueChanged(defaultVal, label)

    knob.InputBegan:Connect(function(input)
        if isConnected and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType.Touch) then
            dragging = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType.Touch) then
            updateValue(input)
        end
    end)
    
    return sliderFrame
end

