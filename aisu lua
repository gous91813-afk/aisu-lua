-- 対象が海レボス（海王・テラーシャーク・サメ・船など / リヴァイアサン除外）か判定
local function isTargetSeaBossModel(obj)
    if not obj:IsA("Model") then return false end
    local name = obj.Name:lower()
    if name:find("leviathan") then
        return false
    end
    return name:find("sea")
        or name:find("terror")
        or name:find("shark")
        or name:find("ship")
        or name:find("pirate")
        or name:find("海王")
end

-- すり抜ける対象か判定
local function isBypassableObstacle(part, shipModel)
    if not part or not part:IsA("BasePart") then return false end
    if part == waterFloorPart or part == snowAnchorPart then return false end
    if player.Character and part:IsDescendantOf(player.Character) then return false end
    if shipModel and part:IsDescendantOf(shipModel) then return false end

    local ancestorModel = part:FindFirstAncestorOfClass("Model")
    if ancestorModel then
        if Players:GetPlayerFromCharacter(ancestorModel) then
            return false
        end
        if isTargetSeaBossModel(ancestorModel) then
            return false
        end
    end

    local n = part.Name:lower()
    local pName = (part.Parent and part.Parent.Name:lower()) or ""

    if n:find("rock") or n:find("stone") or n:find("boulder") or n:find("cliff") or n:find("岩") or n:find("石")
        or pName:find("rock") or pName:find("stone") or pName:find("boulder") or pName:find("岩") or pName:find("石") then
        return true
    end

    if part.Anchored and part.Position.Y > -5 and part.Position.Y < 140 then
        local size = part.Size
        local maxDim = math.max(size.X, size.Y, size.Z)
        local minDim = math.min(size.X, size.Y, size.Z)
        if maxDim >= 3 and maxDim <= 180 and minDim >= 1.5 then
            if not n:find("water") and not n:find("sea") and not n:find("ocean") then
                return true
            end
        end
    end

    return false
end

-- 近くの岩・障害物を自動で透ける（CanCollide = false）ようにする
local function updateRockNoclip(originPos, shipModel)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.CanCollide and isBypassableObstacle(obj, shipModel) then
            if (obj.Position - originPos).Magnitude <= 450 then
                if modifiedRockParts[obj] == nil then
                    modifiedRockParts[obj] = obj.CanCollide
                end
                pcall(function()
                    obj.CanCollide = false
                end)
            end
        end
    end
end

-- 変更した岩・障害物の当たり判定を元に戻す
local function restoreRockCollisions()
    for part, origCollide in pairs(modifiedRockParts) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = origCollide
            end)
        end
    end
    modifiedRockParts = {}
end

-- TP Logic
local function teleportToSeat(isDriverSeat)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local targetSeat = nil
    local shortestDist = math.huge
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local isValidSeat = false
        if isDriverSeat and obj:IsA("VehicleSeat") then
            local nameLower = obj.Name:lower()
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            if not nameLower:find("cannon") and not parentName:find("cannon") and not nameLower:find("turret") and not parentName:find("turret") then
                isValidSeat = true
            end
        elseif not isDriverSeat and obj:IsA("Seat") and not obj:IsA("VehicleSeat") then
            isValidSeat = true
        end
        
        if isValidSeat and obj.Occupant == nil then
            local dist = (obj.Position - character.HumanoidRootPart.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                targetSeat = obj
            end
        end
    end
    
    if targetSeat then
        character.HumanoidRootPart.CFrame = targetSeat.CFrame + Vector3.new(0, 3, 0)
    end
    tpMenuFrame.Visible = false
end

-- 海レボス探索ヘルパー
local function findNearestSeaBoss(originPos)
    local nearestBoss = nil
    local nearestPart = nil
    local shortestDist = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isTargetSeaBossModel(obj) then
            local b_humanoid = obj:FindFirstChildOfClass("Humanoid")
            local isAlive = true
            if b_humanoid and b_humanoid.Health <= 0 then
                isAlive = false
            end

            if isAlive then
                local targetPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("BasePart")
                if targetPart then
                    local dist = (targetPart.Position - originPos).Magnitude
                    if dist < shortestDist and dist < 2500 then
                        shortestDist = dist
                        nearestBoss = obj
                        nearestPart = targetPart
                    end
                end
            end
        end
    end

    return nearestBoss, nearestPart, shortestDist
end

-- 銃（射撃武器）を自動で探して装備するヘルパー
local function equipGunWeapon(character, humanoid)
    if not character or not humanoid then return end

    local equipped = character:FindFirstChildOfClass("Tool")
    local function isGunTool(tool)
        if not tool or not tool:IsA("Tool") then return false end
        local n = tool.Name:lower()
        return n:find("gun")
            or n:find("rifle")
            or n:find("pistol")
            or n:find("blaster")
            or n:find("musket")
            or n:find("bow")
            or n:find("cannon")
            or n:find("銃")
            or tool:GetAttribute("WeaponType") == "Gun"
    end

    if isGunTool(equipped) then
        return
    end

    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if isGunTool(item) then
                pcall(function()
                    humanoid:EquipTool(item)
                end)
                return
            end
        end
    end
end

-- 検知した海レボスへの自動攻撃・スキル発動ヘルパー
local function attackSeaBoss(targetPart)
    local now = tick()
    if targetPart and camera then
        pcall(function()
            local lookAtPos = targetPart.Position + Vector3.new(0, 2, 0)
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, lookAtPos)
        end)
    end

    if now - lastAttackTime >= 0.22 then
        lastAttackTime = now
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end)
    end

    if now - lastSkillTime >= 1.6 then
        lastSkillTime = now
        local skills = { Enum.KeyCode.Z, Enum.KeyCode.X }
        local keyToSend = skills[math.random(1, #skills)]
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, keyToSend, false, game)
            task.wait(0.04)
            VirtualInputManager:SendKeyEvent(false, keyToSend, false, game)
        end)
    end
end

-- 船を指定方向（または前方）へ自動前進させるヘルパー
local function driveBoatToward(seat, dirXZ, speed)
    if not seat or not seat.Parent then return end
    pcall(function()
        seat.Throttle = 1
    end)

    local flatDir = dirXZ
    if not flatDir or flatDir.Magnitude < 0.01 then
        local forward = seat.CFrame.LookVector
        flatDir = Vector3.new(forward.X, 0, forward.Z)
    end

    if flatDir.Magnitude > 0.01 then
        flatDir = flatDir.Unit
        for _, part in ipairs(seat.Parent:GetDescendants()) do
            if part:IsA("BasePart") and not part.Anchored then
                pcall(function()
                    part.AssemblyLinearVelocity = Vector3.new(flatDir.X * speed, part.AssemblyLinearVelocity.Y, flatDir.Z * speed)
                end)
            end
        end
    end
end

