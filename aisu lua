-- 設定の保存・読み込み
local configFileName = "LeviathanSubjugation_Config.json"

local function saveConfig()
    pcall(function()
        if type(writefile) == "function" then
            local data = {
                soundIndex = currentSoundIndex,
                toggleKeyName = toggleKey.Name
            }
            writefile(configFileName, HttpService:JSONEncode(data))
        end
    end)
end

local function loadConfig()
    pcall(function()
        if type(isfile) == "function" and type(readfile) == "function" and isfile(configFileName) then
            local raw = readfile(configFileName)
            local decoded = HttpService:JSONDecode(raw)
            if type(decoded) == "table" then
                if type(decoded.soundIndex) == "number" and soundPresets[decoded.soundIndex] then
                    currentSoundIndex = decoded.soundIndex
                end
                if type(decoded.toggleKeyName) == "string" and Enum.KeyCode[decoded.toggleKeyName] then
                    toggleKey = Enum.KeyCode[decoded.toggleKeyName]
                end
            end
        end
    end)
end

loadConfig()

