local function destroySnowEffect()
    snowFlakes = {}
    if snowOverlayGui then
        pcall(function() snowOverlayGui:Destroy() end)
        snowOverlayGui = nil
    end
    if snowEmitterNear then
        pcall(function() snowEmitterNear:Destroy() end)
        snowEmitterNear = nil
    end
    if snowEmitterFar then
        pcall(function() snowEmitterFar:Destroy() end)
        snowEmitterFar = nil
    end
    if snowAnchorPart then
        pcall(function() snowAnchorPart:Destroy() end)
        snowAnchorPart = nil
    end
end

local function applyBlizzardIntensity()
    local preset = blizzardPresets[blizzardLevel] or blizzardPresets[3]
    blizzardLevelBtn.Text = "吹雪: " .. preset.label
    blizzardLevelBtn.BackgroundColor3 = preset.color

    if not preset.enabled then
        destroySnowEffect()
        return
    end

    if snowEmitterNear and snowEmitterNear.Parent then
        snowEmitterNear.Rate = preset.nearRate
        snowEmitterNear.Speed = preset.nearSpeed
        snowEmitterNear.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, preset.nearTransp),
            NumberSequenceKeypoint.new(0.75, math.min(1, preset.nearTransp + 0.12)),
            NumberSequenceKeypoint.new(1, 1)
        })
    end

    if snowEmitterFar and snowEmitterFar.Parent then
        snowEmitterFar.Rate = preset.farRate
        snowEmitterFar.Speed = preset.farSpeed
        snowEmitterFar.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, preset.farTransp),
            NumberSequenceKeypoint.new(0.8, math.min(1, preset.farTransp + 0.12)),
            NumberSequenceKeypoint.new(1, 1)
        })
    end

    if snowOverlayGui and snowOverlayGui.Parent then
        destroySnowEffect()
    end
end

local function ensureSnowEffect()
    local preset = blizzardPresets[blizzardLevel] or blizzardPresets[3]
    if not preset.enabled then
        destroySnowEffect()
        return
    end

    if not snowOverlayGui or not snowOverlayGui.Parent then
        local overlay = Instance.new("ScreenGui")
        overlay.Name = "FogClearSnowOverlayUI"
        overlay.ResetOnSpawn = false
        overlay.IgnoreGuiInset = true
        overlay.DisplayOrder = 4
        overlay.Parent = uiParent

        snowOverlayGui = overlay
        snowFlakes = {}

        for i = 1, preset.flakeCount do
            local isStreak = (i % 5 == 0)
            local sizeW = isStreak and (blizzardLevel == 4 and 14 or 10) or (blizzardLevel == 2 and 3 or 4)
            local sizeH = isStreak and 2 or (blizzardLevel == 2 and 3 or 4)

            local flake = Instance.new("Frame")
            flake.Name = "UniformSnow_" .. tostring(i)
            flake.Size = UDim2.new(0, sizeW, 0, sizeH)
            flake.Position = UDim2.new(math.random(), 0, math.random(), 0)
            flake.BackgroundColor3 = Color3.fromRGB(245, 250, 255)
            flake.BackgroundTransparency = isStreak and (preset.nearTransp + 0.16) or preset.nearTransp
            flake.Rotation = isStreak and (blizzardLevel == 4 and -20 or -15) or 0
            flake.BorderSizePixel = 0
            flake.ZIndex = 1
            flake.Parent = overlay

            local flakeCorner = Instance.new("UICorner")
            flakeCorner.CornerRadius = UDim.new(1, 0)
            flakeCorner.Parent = flake

            table.insert(snowFlakes, {
                gui = flake,
                x = math.random(),
                y = math.random(),
                fallSpeed = preset.fallSpeed * (0.9 + math.random() * 0.2),
                driftSpeed = preset.driftSpeed * (0.9 + math.random() * 0.2),
                swayAmp = 0.008,
                swayFreq = 1.4,
                phase = math.random() * math.pi * 2
            })
        end
    end

    if not snowAnchorPart or not snowAnchorPart.Parent or not snowEmitterNear or not snowEmitterNear.Parent or not snowEmitterFar or not snowEmitterFar.Parent then
        if snowEmitterNear then pcall(function() snowEmitterNear:Destroy() end) end
        if snowEmitterFar then pcall(function() snowEmitterFar:Destroy() end) end
        if snowAnchorPart then pcall(function() snowAnchorPart:Destroy() end) end

        local part = Instance.new("Part")
        part.Name = "FogClearSnowAnchor"
        part.Size = Vector3.new(130, 55, 130)
        part.Transparency = 1
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Parent = Workspace

        local nearEmitter = Instance.new("ParticleEmitter")
        nearEmitter.Name = "UniformBlizzardNear"
        nearEmitter.Color = ColorSequence.new(Color3.fromRGB(248, 252, 255))
        nearEmitter.LightEmission = 0.12
        nearEmitter.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.22),
            NumberSequenceKeypoint.new(0.5, 0.28),
            NumberSequenceKeypoint.new(1, 0.16)
        })
        nearEmitter.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, preset.nearTransp),
            NumberSequenceKeypoint.new(0.75, math.min(1, preset.nearTransp + 0.12)),
            NumberSequenceKeypoint.new(1, 1)
        })
        nearEmitter.Lifetime = NumberRange.new(3.5, 5.0)
        nearEmitter.Rate = preset.nearRate
        nearEmitter.Speed = preset.nearSpeed
        nearEmitter.SpreadAngle = Vector2.new(75, 75)
        nearEmitter.EmissionDirection = Enum.NormalId.Bottom
        nearEmitter.Acceleration = Vector3.new(preset.windX, -2.0, preset.windZ)
        nearEmitter.RotSpeed = NumberRange.new(-60, 60)
        nearEmitter.Rotation = NumberRange.new(0, 360)
        nearEmitter.Drag = 1.3
        nearEmitter.Parent = part

        local farEmitter = Instance.new("ParticleEmitter")
        farEmitter.Name = "UniformBlizzardFar"
        farEmitter.Color = ColorSequence.new(Color3.fromRGB(235, 245, 255))
        farEmitter.LightEmission = 0.08
        farEmitter.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.45),
            NumberSequenceKeypoint.new(0.5, 0.60),
            NumberSequenceKeypoint.new(1, 0.35)
        })
        farEmitter.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, preset.farTransp),
            NumberSequenceKeypoint.new(0.8, math.min(1, preset.farTransp + 0.12)),
            NumberSequenceKeypoint.new(1, 1)
        })
        farEmitter.Lifetime = NumberRange.new(4.5, 6.5)
        farEmitter.Rate = preset.farRate
        farEmitter.Speed = preset.farSpeed
        farEmitter.SpreadAngle = Vector2.new(85, 85)
        farEmitter.EmissionDirection = Enum.NormalId.Bottom
        farEmitter.Acceleration = Vector3.new(preset.windX * 1.08, -1.8, preset.windZ * 1.08)
        farEmitter.RotSpeed = NumberRange.new(-45, 45)
        farEmitter.Rotation = NumberRange.new(0, 360)
        farEmitter.Drag = 1.5
        farEmitter.Parent = part

        snowAnchorPart = part
        snowEmitterNear = nearEmitter
        snowEmitterFar = farEmitter
    end
end

local function updateSnowEffect(dt)
    if not removeFogEnabled or not isConnected then return end
    local preset = blizzardPresets[blizzardLevel] or blizzardPresets[3]
    if not preset.enabled then
        destroySnowEffect()
        return
    end

    ensureSnowEffect()

    local now = tick()
    local windX = preset.windX + math.sin(now * 0.9) * 1.6
    local windZ = preset.windZ + math.cos(now * 0.75) * 1.3

    if snowAnchorPart and snowAnchorPart.Parent then
        local basePos = (camera and camera.CFrame.Position)
            or (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position)
            or Vector3.zero

        snowAnchorPart.CFrame = CFrame.new(basePos.X, basePos.Y + 6, basePos.Z)

        if snowEmitterNear and snowEmitterNear.Parent then
            snowEmitterNear.Acceleration = Vector3.new(windX, -2.0, windZ)
        end
        if snowEmitterFar and snowEmitterFar.Parent then
            snowEmitterFar.Acceleration = Vector3.new(windX * 1.08, -1.8, windZ * 1.08)
        end
    end

    for _, flake in ipairs(snowFlakes) do
        if flake.gui and flake.gui.Parent then
            flake.y = flake.y + flake.fallSpeed * dt
            flake.x = flake.x + flake.driftSpeed * dt

            if flake.y > 1.04 then
                flake.y = -0.04
            end
            if flake.x > 1.04 then
                flake.x = -0.04
            end

            local swayX = math.sin(now * flake.swayFreq + flake.phase) * flake.swayAmp
            flake.gui.Position = UDim2.new(flake.x + swayX, 0, flake.y, 0)
        end
    end
end

-- Fog Clear（影なし・スッキリ視界 + 吹雪ON時のみエフェクト）
local function updateFog()
    if removeFogEnabled and isConnected then
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 2.6
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("Atmosphere") then
                v.Density = 0
                v.Haze = 0
                v.Glare = 0
            elseif v:IsA("PostEffect") then
                v.Enabled = false
            end
        end

        local preset = blizzardPresets[blizzardLevel] or blizzardPresets[3]
        if preset.enabled then
            ensureSnowEffect()
        else
            destroySnowEffect()
        end
    end
end

